    "\n",
    "\n",
    "        if self.verbose:\n",
    "            print(f\"Initialized grid with shape: {self.grid.shape}\")\n",
    "\n",
    "        # Right boudary condition for expired option, when time is 0, the option value is the payoff.\n",
